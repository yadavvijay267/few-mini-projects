{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Tester\", \"email\": \"a@test.dev\", \"password\": \"secret123\"}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"a@test.dev\", \"password\": \"secret123\"}"
        }
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks?status=todo&page=1&limit=10"
      }
    },
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Design fiber route\", \"priority\": \"high\"}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ]
}